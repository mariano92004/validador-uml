@startuml
left to right direction
' Tienda online
actor Cliente
actor "Administrador" as Admin
actor "Pasarela de pago" as Pasarela

rectangle "Tienda online" {
  usecase "Buscar productos" as UC1
  usecase "Comprar productos" as UC2
  usecase "Pagar pedido" as UC3
  usecase "Aplicar cupón" as UC4
  usecase "Gestionar catálogo" as UC5
  usecase "Iniciar sesión" as UC6
}

Cliente --> UC1
Cliente --> UC2
UC2 ..> UC3 : <<include>>
UC4 ..> UC2 : <<extend>>
UC3 --> Pasarela
Admin --> UC5
UC5 ..> UC6 : <<include>>
@enduml
